{
  "human_behavior": {
    "sleep": {
      "min_ms": 500,
      "max_ms": 2000,
      "after_click_min_ms": 800,
      "after_click_max_ms": 1500
    },
    "scroll": {
      "min_distance": 200,
      "max_distance": 600,
      "min_duration_ms": 300,
      "max_duration_ms": 800
    },
    "random_browse": {
      "enabled": true,
      "probability": 0.1,
      "actions": ["scroll_up", "scroll_down", "wait"]
    }
  },
  "risk_detection": {
    "captcha_keywords": ["验证码", "滑动验证", "安全验证", "captcha", "verify", "拼图"],
    "login_keywords": ["登录", "请登录", "登录后查看", "login", "sign in"],
    "rate_limit_keywords": ["操作频繁", "请稍后再试", "访问过于频繁", "请稍后"],
    "block_keywords": ["账号异常", "暂时无法访问", "违规", "封禁"],
    "ui_anomaly": {
      "min_node_count": 10,
      "empty_page_threshold": 5
    }
  },
  "cooldown": {
    "enabled": true,
    "trigger_on_risk": true,
    "duration_minutes": 15,
    "max_continuous_tasks": 10
  },
  "taobao": {
    "tasks_per_cycle": [3, 5],
    "cycles_before_cooldown": [3, 5],
    "browse_duration_minutes": [2, 5],
    "cooldown_duration_minutes": 15,
    "click_offset_max_px": 5,
    "time_cooldown_interval_minutes": 30,
    "time_cooldown_duration_minutes": [5, 10],
    "risk_cooldown_durations": {
      "captcha": 15,
      "login_required": 20,
      "blocked": 30,
      "rate_limit": 15
    }
  }
}
