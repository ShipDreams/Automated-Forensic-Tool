{
  "app_store_search_protocols": {
    "description": "各品牌应用商店搜索协议（品牌自适应）",
    "xiaomi": "mimarket://search?q=淘宝",
    "redmi": "mimarket://search?q=淘宝",
    "huawei": "appmarket://search?keyword=淘宝",
    "honor": "appmarket://search?keyword=淘宝",
    "oppo": "oppomarket://search?keyword=淘宝",
    "oneplus": "oppomarket://search?keyword=淘宝",
    "realme": "oppomarket://search?keyword=淘宝",
    "vivo": "vivomarket://search?keyword=淘宝",
    "iqoo": "vivomarket://search?keyword=淘宝",
    "samsung": "samsungapps://SearchDetail/淘宝",
    "meizu": "mstore://search?keyword=淘宝",
    "generic": "market://search?q=淘宝",
    "notes": "小米/红米使用 q 参数，其他品牌使用 keyword 参数"
  },
  "app_store_open_button": {
    "description": "应用商店搜索结果页的'打开'按钮定位规则（支持多个按钮）",
    "text_keywords": ["打开", "Open", "OPEN", "启动", "Launch", "LAUNCH"],
    "content_desc_keywords": ["打开", "Open", "启动", "Launch"],
    "resource_ids": [
      "btn_open",
      "button_open",
      "open_button",
      "app_open",
      "action_button",
      "open",
      "btn_action"
    ],
    "prefer_first": true,
    "notes": "搜索结果中可能有多个'打开'按钮，优先选择第一个（通常是官方App）"
  },
  "video_element_strategies": [
    {
      "name": "resource_id",
      "enabled": true,
      "keywords": ["video", "player", "play", "media", "主图"]
    },
    {
      "name": "content_desc",
      "enabled": true,
      "keywords": ["播放", "视频", "play", "video", "主图"]
    },
    {
      "name": "text",
      "enabled": true,
      "keywords": ["播放", "视频", "play"]
    },
    {
      "name": "class_region",
      "enabled": true,
      "description": "顶部 1/3 区域的可点击元素",
      "region_ratio": 0.33
    }
  ],
  "max_attempts": 3,
  "taobao_config": {
    "package_name": "com.taobao.taobao",
    "main_activity": "com.taobao.taobao/.home.activity.MainActivity",
    "common_element_ids": [
      "com.taobao.taobao:id/video",
      "com.taobao.taobao:id/player",
      "com.taobao.taobao:id/mainPic"
    ]
  },
  "notes": "UI 定位规则配置，支持品牌自适应应用商店搜索和淘宝 App"
}
